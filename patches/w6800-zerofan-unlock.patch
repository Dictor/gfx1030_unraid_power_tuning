+	/*
+	 * W6800 zerofan: unlock SMU Zero-RPM capability and configure a 60 C
+	 * hardware fail-safe start temperature in PPTable/OverDrive limits on
+	 * Radeon PRO W6800 (0x1002:0x73a3). Keep FanZeroRpmEnable = 0 at boot
+	 * so default automatic mode (pwm1_enable=2) runs the stock VBIOS curve.
+	 */
+	if (adev->pdev->vendor == 0x1002 && adev->pdev->device == 0x73a3) {
+		struct smu_11_0_7_powerplay_table *powerplay_table =
+			smu->smu_table.power_play_table;
+		uint16_t *fan_stop_temp, *fan_start_temp;
+		uint8_t *fan_zero_rpm_enable;
+
+		GET_PPTABLE_MEMBER(FanStopTemp, &fan_stop_temp);
+		GET_PPTABLE_MEMBER(FanStartTemp, &fan_start_temp);
+		GET_PPTABLE_MEMBER(FanZeroRpmEnable, &fan_zero_rpm_enable);
+
+		*fan_stop_temp = 55;
+		*fan_start_temp = 60;
+		*fan_zero_rpm_enable = 0;
+
+		if (powerplay_table) {
+			powerplay_table->overdrive_table.cap[SMU_11_0_7_ODCAP_FAN_ZERO_RPM_CONTROL] = 1;
+			powerplay_table->overdrive_table.min[SMU_11_0_7_ODSETTING_FAN_ZERO_RPM_CONTROL] = 25;
+			powerplay_table->overdrive_table.max[SMU_11_0_7_ODSETTING_FAN_ZERO_RPM_CONTROL] = 60;
+		}
+
+		dev_notice(adev->dev,
+			   "W6800 zerofan: unlocked SMU Zero-RPM capability (fail-safe 60 C) on %s\n",
+			   dev_name(adev->dev));
+	}
+
 	return 0;
 }
 
