 }
 
+static noinline int sienna_cichlid_w6800_zerofan_unlock(struct smu_context *smu,
+							bool enable_zero_rpm)
+{
+	struct smu_table_context *table_context = &smu->smu_table;
+	OverDriveTable_t *od_table =
+		(OverDriveTable_t *)table_context->overdrive_table;
+	OverDriveTable_t *user_od_table =
+		(OverDriveTable_t *)table_context->user_overdrive_table;
+	uint16_t *fan_stop_temp, *fan_start_temp;
+	uint8_t *fan_zero_rpm_enable;
+	int ret;
+
+	GET_PPTABLE_MEMBER(FanStopTemp, &fan_stop_temp);
+	GET_PPTABLE_MEMBER(FanStartTemp, &fan_start_temp);
+	GET_PPTABLE_MEMBER(FanZeroRpmEnable, &fan_zero_rpm_enable);
+
+	*fan_stop_temp = 55;
+	*fan_start_temp = 60;
+	*fan_zero_rpm_enable = enable_zero_rpm ? 1 : 0;
+
+	ret = smu_cmn_write_pptable(smu);
+	if (ret)
+		return ret;
+
+	if (od_table) {
+		od_table->FanZeroRpmEnable = enable_zero_rpm ? 1 : 0;
+		od_table->FanZeroRpmStopTemp = 55;
+		ret = smu_cmn_update_table(smu, SMU_TABLE_OVERDRIVE,
+					   0, (void *)od_table, true);
+		if (!ret && user_od_table) {
+			user_od_table->FanZeroRpmEnable = od_table->FanZeroRpmEnable;
+			user_od_table->FanZeroRpmStopTemp = od_table->FanZeroRpmStopTemp;
+		}
+	}
+
+	return 0;
+}
+
+static uint32_t sienna_cichlid_get_fan_control_mode(struct smu_context *smu)
+{
+	struct amdgpu_device *adev = smu->adev;
+
+	if (adev->pdev->vendor == 0x1002 &&
+	    adev->pdev->device == 0x73a3 &&
+	    smu->user_dpm_profile.fan_mode == AMD_FAN_CTRL_MANUAL)
+		return AMD_FAN_CTRL_MANUAL;
+
+	return smu_v11_0_get_fan_control_mode(smu);
+}
+
+static int sienna_cichlid_set_fan_control_mode(struct smu_context *smu,
+					       uint32_t mode)
+{
+	struct amdgpu_device *adev = smu->adev;
+
+	if (adev->pdev->vendor == 0x1002 &&
+	    adev->pdev->device == 0x73a3 &&
+	    mode == AMD_FAN_CTRL_AUTO) {
+		sienna_cichlid_w6800_zerofan_unlock(smu, false);
+		smu_v11_0_set_fan_control_mode(smu, AMD_FAN_CTRL_MANUAL);
+		smu_v11_0_set_fan_speed_pwm(smu, 65);
+	}
+
+	return smu_v11_0_set_fan_control_mode(smu, mode);
+}
+
+static int sienna_cichlid_set_fan_speed_pwm(struct smu_context *smu,
+					    uint32_t speed)
+{
+	struct amdgpu_device *adev = smu->adev;
+	int ret;
+
+	if (adev->pdev->vendor == 0x1002 && adev->pdev->device == 0x73a3) {
+		if (speed == 0) {
+			ret = sienna_cichlid_w6800_zerofan_unlock(smu, true);
+			if (ret)
+				return ret;
+			return smu_v11_0_set_fan_control_mode(smu, AMD_FAN_CTRL_AUTO);
+		}
+
+		sienna_cichlid_w6800_zerofan_unlock(smu, false);
+		ret = smu_v11_0_set_fan_control_mode(smu, AMD_FAN_CTRL_MANUAL);
+		if (ret)
+			return ret;
+	}
+
+	return smu_v11_0_set_fan_speed_pwm(smu, speed);
+}
